        "code": {
            "group": "code",
            "pipelines": ["default"],
            "description": "Programming, software development, dev-ops, debugging, and technical implementation"
        },
        "translation": {
            "group": "translation",
            "pipelines": ["default"],
            "description": "Translation between different languages"
        }
