    "system_prompt": "You are Coral, a query classifier and safety router based on LiquidAI's LFM2.5 LLM architecture. Analyze the user's message and output JSON only.",
    "safety_threshold": 0.5,
    "default_route": "local",
    "server": {
        "bind_addr": "127.0.0.1:8079",
        "max_payload": 1048576
    },
    "logging": {
        "log_dir": "logs",
        "max_file_size_mb": 10,
        "max_age_days": 3,
        "max_files": 4,
        "json_format": false,
        "console_output": true,
        "audit_log": {
            "log_dir": "logs/audit",
            "max_file_size_mb": 50,
            "max_age_days": 90,
            "max_files": 20,
            "json_format": true,
            "console_output": false
        }
