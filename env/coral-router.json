    "model_groups": {
        "classifier": ["fast"],
        "question": ["fast"],
        "command": ["fast"],
        "code": ["qwythos-9b"],
        "chitchat": ["fast"],
        "psychology": ["fast"],
        "translation": ["translation"],
        "orchestrator": ["qwythos-9b"],
        "ledger": ["qwythos-9b"]
    },
    "routes": {
        "local": { "group": "classifier", "pipelines": ["default"] },
        "code": { "group": "code", "pipelines": ["default"] },
        "question": { "group": "question", "pipelines": ["default"] },
        "command": { "group": "command", "pipelines": ["default"] },
        "creative": { "group": "classifier", "pipelines": ["default"] },
        "chitchat": { "group": "chitchat", "pipelines": ["default"] },
        "psychology": { "group": "psychology", "pipelines": ["default"] },
        "translation": { "group": "translation", "pipelines": ["default"] }
    },
    "score_matrix": {
        "dimensions": ["coherence", "complexity", "completeness", "risk"],
        "weights": [0.3, 0.2, 0.3, 0.2],
        "routes": {
            "plan": {
                "bands": { "completeness": [0.0, 0.5] }
            },
            "rigor": {
                "bands": { "completeness": [0.7, 1.0], "risk": [0.4, 1.0] }
            },
            "local": {
                "bands": { "completeness": [0.7, 1.0], "risk": [0.0, 0.4] }
            }
        }
    },
    "system_prompt": "You are a query classifier and safety router. Analyze the user's message and output JSON only.\n\nOutput schema:\n{\n  \"action\": \"respond\" | \"route\" | \"reject\",\n  \"response\": \"direct answer (only if action=respond)\",\n  \"target\": \"route name (only if action=route)\",\n  \"coherence_score\": 0.0-1.0,\n  \"safety_score\": 0.0-1.0,\n  \"complexity\": 0-10,\n  \"intent\": \"question\" | \"command\" | \"creative\" | \"code\" | \"chitchat\" | \"psychology\" | \"translation\",\n  \"completeness\": 0.0-1.0,\n  \"risk\": 0.0-1.0,\n  \"reason\": \"brief explanation\"\n}\n\nRules:\n- If the query is trivial (simple arithmetic, basic fact, greeting), set action=respond and provide the answer.\n- If the query is safe and well-formed, set action=route with target=\"local\".\n- If the query is a coding task, set action=route with target=\"code\".\n- If content is incoherent (coherence_score < {coherence_threshold}), set action=reject.\n- If content is unsafe (safety_score < {safety_threshold}), set action=reject.\n- Safety score 1.0 = completely safe, 0.0 = dangerous.\n- Complexity 0 = trivial, 10 = extremely complex. Higher complexity queries are routed to models with matching intelligence level.\n- Completeness 0.0-1.0: how well-specified/complete the request is. Low completeness (< 0.5) triggers the plan route for clarification.\n- Risk 0.0-1.0: perceived sensitivity/risk level. High risk (> 0.4) with high completeness triggers the rigor route for adversarial validation.\n\nOnly output JSON, no other text.",
    "classifier_model": "fast",
    "safety_threshold": 0.5,
    "default_route": "local",
    "server": {
        "bind_addr": "127.0.0.1:8079",
        "max_payload": 1048576
    },
    "logging": {
        "log_dir": "logs",
        "max_file_size_mb": 10,
        "max_age_days": 3,
        "max_files": 4,
        "json_format": false,
        "console_output": true,
        "audit_log": {
            "log_dir": "logs/audit",
            "max_file_size_mb": 50,
            "max_age_days": 90,
            "max_files": 20,
            "json_format": true,
            "console_output": false
        }
    }
}
