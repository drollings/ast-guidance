{
    "pipelines": {
        "default": {
            "deterministic_prefilter": true,
            "classifier": true,
            "router": true,
            "coherence_threshold": 0.70,
            "classifier_model": "fast",
            "blacklist": "env/pii-patterns.json"
        }
    },
    "models": {
        "fast": {
            "endpoint": "http://localhost:8080/v1/chat/completions",
            "name": "fast",
            "intelligence": 1,
            "cost_input": 0.000001,
            "cost_output": 0.000006,
            "cost_cached_read": 0.0000004,
            "speed": 10,
            "total_timeout_ms": 5000,
            "idle_timeout_ms": 2000,
            "stream": true,
            "filter_thinking": true,
            "retry_count": 2,
            "retry_base_interval_s": 1,
            "params": {
                "num_ctx": 32768,
                "max_tokens": 1024,
                "temperature": 0.1
            }
        },
        "code": {
            "endpoint": "http://localhost:8080/v1/chat/completions",
            "name": "code",
            "intelligence": 6,
            "cost_input": 0.000003,
            "cost_output": 0.000018,
            "cost_cached_read": 0.0000012,
            "speed": 5,
            "total_timeout_ms": 120000,
            "idle_timeout_ms": 10000,
            "stream": true,
            "filter_thinking": false,
            "retry_count": 1,
            "retry_base_interval_s": 2,
            "params": {
                "num_ctx": 131072,
                "temperature": 0.6
            }
        },
        "agent": {
            "endpoint": "http://localhost:8080/v1/chat/completions",
            "name": "agent",
            "intelligence": 6,
            "cost_input": 0.000003,
            "cost_output": 0.000018,
            "cost_cached_read": 0.0000012,
            "speed": 6,
            "total_timeout_ms": 120000,
            "idle_timeout_ms": 10000,
            "stream": true,
            "filter_thinking": true,
            "retry_count": 3,
            "retry_base_interval_s": 2,
            "params": {
                "num_ctx": 65536
            }
        }
    },
    "model_groups": {
        "fast": ["fast"],
        "code": ["code"],
        "agents": ["agent"]
    },
    "routes": {
        "local": { "group": "fast", "pipelines": ["default"] }
    },
    "system_prompt": "You are a query classifier and safety router. Analyze the user's message and output JSON only.\n\nOutput schema:\n{\n  \"action\": \"respond\" | \"route\" | \"reject\",\n  \"response\": \"direct answer (only if action=respond)\",\n  \"target\": \"route name (only if action=route)\",\n  \"coherence_score\": 0.0-1.0,\n  \"safety_score\": 0.0-1.0,\n  \"complexity\": 0-10,\n  \"intent\": \"question\" | \"command\" | \"creative\" | \"code\" | \"chitchat\",\n  \"reason\": \"brief explanation\"\n}\n\nRules:\n- If the query is trivial (simple arithmetic, basic fact, greeting), set action=respond and provide the answer.\n- If the query is safe and well-formed, set action=route with target=\"fast\".\n- If the query is a coding task, set action=route with target=\"code\".\n- If content is incoherent (coherence_score < 0.3), set action=reject.\n- If content is unsafe (safety_score < 0.5), set action=reject.\n- Safety score 1.0 = completely safe, 0.0 = dangerous.\n- Complexity 0 = trivial, 10 = extremely complex. Higher complexity queries are routed to models with matching intelligence level.\n\nOnly output JSON, no other text.",
    "classifier_model": "fast",
    "safety_threshold": 0.5,
    "default_route": "fast",
    "server": {
        "bind_addr": "127.0.0.1:8081",
        "max_payload": 1048576
    },
    "logging": {
        "log_dir": "logs",
        "max_file_size_mb": 100,
        "max_age_days": 7,
        "max_files": 10,
        "json_format": false,
        "console_output": true
    }
}
