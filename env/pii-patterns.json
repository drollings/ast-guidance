{
  "patterns": [
    {
      "name": "card_number",
      "outcome": "output_filter",
      "filter_action": "redact",
      "confidence_gate": "luhn_valid",
      "scope": ["frontier_bound"],
      "http_code": 422,
      "error_message": "Credit card number detected in request",
      "regexes": [
        "\\b(?:\\d[ -]*?){13,19}\\b"
      ]
    },
    {
      "name": "ssn",
      "outcome": "output_filter",
      "filter_action": "redact",
      "scope": ["frontier_bound"],
      "http_code": 422,
      "error_message": "SSN detected in request",
      "regexes": [
        "\\b\\d{3}-\\d{2}-\\d{4}\\b"
      ]
    },
    {
      "name": "email",
      "outcome": "output_filter",
      "filter_action": "anonymize",
      "scope": ["frontier_bound"],
      "http_code": 422,
      "error_message": "Email address detected in request",
      "regexes": [
        "\\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}\\b"
      ]
    },
    {
      "name": "phone",
      "outcome": "output_filter",
      "filter_action": "anonymize",
      "scope": ["frontier_bound"],
      "http_code": 422,
      "error_message": "Phone number detected in request",
      "regexes": [
        "\\b(?:\\+\\d{1,3}[-.\\s]?)?\\(?\\d{3}\\)?[-.\\s]?\\d{3}[-.\\s]?\\d{4}\\b"
      ]
    },
    {
      "name": "api_key",
      "outcome": "hard_reject",
      "scope": ["any"],
      "http_code": 422,
      "error_message": "API key or secret token detected in request",
      "regexes": [
        "(?i)(?:api[_-]?key|secret|token|password)\\s*[:=]\\s*[^\\s]{8,}"
      ]
    }
  ]
}
