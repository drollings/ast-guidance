  "_comment_routes": "`always_route: true` marks the route as dispatch-only: its response function is a dispatch to the route's group, never a classifier direct answer, even at maximum confidence. Routes without it keep `always_route: false` so the classifier may answer simple prompts directly; `local` is the sole direct-answer (respond-eligible) domain. The route table is the functional tool taxonomy: each route key is a functionally-disjoint response function (code / summarize / explore / explain / prose), plus `local` as the general Q&A category that is the classifier's own territory (see needle.schema_overrides.local.general). Subject-matter routing (science, medical, legal, translation, entity recognition) is handled as bounded subagent plans dispatched after a tool is selected, not as separate top-level routes.",
  "routes": {
    "local": {
      "group": "default",
      "pipelines": [
        "default"
      ],
      "description": "General Q&A, simple questions, chitchat, research queries, brainstorming, and help formulating prompts. Answered directly by the classifier when simple.",
      "always_route": false
    },
    "code": {
      "group": "code",
      "pipelines": [
        "default"
      ],
      "description": "Programming, software development, Linux, bash, Python, Rust, dev-ops, debugging, and technical implementation - write, debug, or explain code.",
      "always_route": true
    },
    "summarize": {
      "group": "summarize",
      "pipelines": [
        "default"
      ],
      "description": "Summarize or condense text - an article, report, email thread, meeting notes, or other content, into a shorter form."
    },
    "explore": {
      "group": "explore",
      "pipelines": [
        "default"
      ],
      "description": "Search, navigate, look up, or pull a value - search the web, open a page, look up an API, query data storage or a knowledge graph, or extract a specific value (a date, amount, email, or identifier) from text.",
      "always_route": true
    },
    "explain": {
      "group": "explain",
      "pipelines": [
        "default"
      ],
      "description": "A deep answer - translate between languages, analyze or reason about a topic, identify named entities in text, or explain a concept from the sciences, mathematics, medicine, or law.",
      "always_route": true
    },
    "prose": {
      "group": "prose",
      "pipelines": [
        "default"
      ],
      "description": "Write a story, novel, poem, essay, screenplay, or letter - any substantial creative writing.",
      "always_route": true
    }
  },
  "_comment_model_groups": "Each model_group is an ordered target-matching ladder (VISION 'Target selection within a group'): the cheapest candidate self-assesses the request's complexity first and defers to the next, more-intelligent member when the assessed complexity exceeds its `intelligence`. `explore` leads with a cheap capable model (the value-pull fast path); `explain` leads with the capable model (deep answers). Single-member groups resolve statically. Controlled per pipeline via `pipelines.<name>.target_match` (\"self_assess\" default | \"static\") and `target_match_timeout_ms`.",
  "model_groups": {
    "default": [
      "lfm2.5-2.6b:default"
    ],
    "code": [
      "qwen3.6-27b"
    ],
    "summarize": [
      "lfm2.5-2.6b:default"
    ],
    "explore": [
      "lfm2.5-2.6b:default"
    ],
    "explain": [
      "qwen3.6-27b"
    ],
    "prose": [
      "qwen3.6-27b"
    ]
  },
  "system_prompt": "You are Coral, an AI assistant based on a team of edge language models. Analyze the user's message and output JSON only.",
  "safety_threshold": 0.3,
  "default_route": "local",
  "charts": {
    "dir": "env/workflows/charts",
    "index_path": "data/workflow_library.sqlite",
    "selector_model": "lfm2.5-2.6b:default",
    "max_candidates": 5,
    "min_score": 0.6,
    "entity_context": true
  },
  "post_process": {
    "workflow_extraction": false
  },
  "ledger": {
    "path": "data/ledger.sqlite",
    "model": "lfm2.5-2.6b:default"
  },
  "session": {
    "root": "data/sessions"
  },
  "embedding_model": "embed",
  "gguf_dir": "/app/ai/models/gguf",
  "server": {
    "bind_addr": "127.0.0.1:8079",
    "max_payload": 1048576
  },
  "sidecar": {
    "poll_interval_s": 5,
    "vram_low_watermark_bytes": 1024000000,
    "evict_batch": 1,
    "vram_total_bytes": null,
    "minimum_remaining_vram": 2048000000,
    "slot_save_path": "data/slots",
    "resume_ttl_s": 3600,
    "api_key_env": null
  },
  "logging": {
    "log_dir": "logs",
    "max_file_size_mb": 10,
    "max_age_days": 3,
    "max_files": 4,
    "json_format": false,
    "console_output": true,
    "audit_log": {
      "log_dir": "logs/audit",
      "max_file_size_mb": 50,
      "max_age_days": 90,
      "max_files": 20,
      "json_format": true,
      "console_output": false
    }
  }
