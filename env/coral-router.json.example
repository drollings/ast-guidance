    "routes": {
        "local": {
            "group": "question",
            "pipelines": ["default"],
            "description": "General Q&A, simple questions, research queries"
        },
        "chat": {
            "group": "chitchat",
            "pipelines": ["default"],
            "description": "Chit-chat, personal banter"
        },
        "prose": {
            "group": "prose",
            "pipelines": ["default"],
            "description": "Creative writing, stories, poems, essays, letters, correspondence, novel-writing"
        },
        "code": {
            "group": "code",
            "pipelines": ["default"],
            "description": "Programming, software development, dev-ops, debugging, and technical implementation"
        },
        "translation": {
            "group": "translation",
            "pipelines": ["default"],
            "description": "Translation between different languages"
        }
    },
    "_comment_model_groups": "Each model_group is an ordered target-matching ladder (VISION 'Target selection within a group'): the cheapest candidate self-assesses the request's complexity first and defers to the next, more-intelligent member when the assessed complexity exceeds its `intelligence`. Single-member groups resolve statically. Controlled per pipeline via `pipelines.<name>.target_match` (\"self_assess\" default | \"static\") and `target_match_timeout_ms`.",
    "model_groups": {
        "classifier": [
            "swarm"
        ],
        "question": [
            "swarm"
        ],
        "command": [
            "swarm"
        ],
        "code": [
            "qwen3.6-27b"
        ],
        "chitchat": [
            "swarm"
        ],
        "psychology": [
            "qwen3.6-27b"
        ],
        "translation": [
            "translation"
        ],
        "prose": [
            "prose"
        ],
        "ledger": [
            "swarm"
        ]
    },
    "system_prompt": "You are Coral, a query classifier and safety router based on an amalgam of edge language models. Analyze the user's message and output JSON only.",
    "safety_threshold": 0.3,
    "default_route": "local",
    "charts": {
        "dir": "env/workflows/charts",
        "index_path": "data/workflow_library.sqlite",
        "selector_model": "swarm",
        "max_candidates": 5,
        "min_score": 0.6,
        "entity_context": true
    },
    "post_process": {
        "workflow_extraction": false
    },
    "embedding_model": "embed",
    "server": {
        "bind_addr": "127.0.0.1:8079",
        "max_payload": 1048576
    },
    "logging": {
        "log_dir": "logs",
        "max_file_size_mb": 10,
        "max_age_days": 3,
        "max_files": 4,
        "json_format": false,
        "console_output": true,
        "audit_log": {
            "log_dir": "logs/audit",
            "max_file_size_mb": 50,
            "max_age_days": 90,
            "max_files": 20,
            "json_format": true,
            "console_output": false
        }
    }
}
