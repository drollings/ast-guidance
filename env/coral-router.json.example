{
    "pipelines": {
        "default": {
            "deterministic_prefilter": true,
            "classifier": true,
            "router": true,
            "coherence_threshold": 0.5,
            "classifier_model": "swarm",
            "blacklist": "env/pii-patterns.json"
        }
    },
    "models": {
        "swarm": {
            "endpoint": "http://localhost:8080/v1/chat/completions",
            "name": "bartowski/liquidai_lfm2.5-2.6b",
            "intelligence": 2,
            "cost_input": 1e-06,
            "cost_output": 6e-06,
            "cost_cached_read": 4e-07,
            "speed": 8,
            "total_timeout_ms": 30000,
            "idle_timeout_ms": 6000,
            "stream": true,
            "filter_thinking": true,
            "retry_count": 2,
            "retry_base_interval_s": 1,
            "params": {
                "num_ctx": 163840,
                "parallel": 2,
                "sleep_idle_seconds": 7200
            },
            "sessions": {
                "ledger": {
                    "num_ctx": 81920,
                    "params": {
                        "temperature": 0.1
                    }
                },
                "scratch": {
                    "num_ctx": 81920,
                    "params": {
                        "temperature": 0.4,
                        "sleep_idle_seconds": 0
                    }
                }
            }
        },
        "qwen3.5-9b": {
