  "_comment_onnx": "In-process ONNX roles are optional; declare under onnx or as top-level role keys.",
  "classification": {
    "root": {
      "type": "classifier",
      "description": "Coral request router",
      "model": "code:default",
      "coherence_threshold": 0.5,
      "safety_threshold": 0.3,
      "children": [
        {
          "key": "local",
          "description": "General Q&A, simple questions, chitchat, research queries, brainstorming, and help formulating prompts. Answered directly by the classifier when simple.",
          "node": {
            "type": "terminal",
            "route": "local",
            "group": "default",
            "description": "General Q&A",
            "always_route": false
          }
        },
        {
          "key": "code",
          "description": "Programming, software development, Linux, bash, Python, Rust, dev-ops, debugging, and technical implementation - write, debug, or explain code.",
          "node": {
            "type": "terminal",
            "route": "code",
            "group": "code",
            "description": "Code",
            "always_route": true
          }
        },
        {
          "key": "summarize",
          "description": "Summarize or condense text - an article, report, email thread, meeting notes, or other content, into a shorter form.",
          "node": {
            "type": "terminal",
            "route": "summarize",
            "group": "summarize",
            "description": "Summarize",
            "always_route": false
          }
        },
        {
          "key": "explore",
          "description": "Search, navigate, look up, or pull a value - search the web, open a page, look up an API, query data storage or a knowledge graph, or extract a specific value (a date, amount, email, or identifier) from text.",
          "node": {
            "type": "terminal",
            "route": "explore",
            "group": "explore",
            "description": "Explore",
            "always_route": true
          }
        },
        {
          "key": "explain",
          "description": "A deep answer - translate between languages, analyze or reason about a topic, identify named entities in text, or explain a concept from the sciences, mathematics, medicine, or law.",
          "node": {
            "type": "terminal",
            "route": "explain",
            "group": "explain",
            "description": "Explain",
            "always_route": true
          }
        },
        {
          "key": "prose",
          "description": "Write a story, novel, poem, essay, screenplay, or letter - any substantial creative writing.",
          "node": {
            "type": "terminal",
            "route": "prose",
            "group": "prose",
            "description": "Prose",
            "always_route": true
          }
        }
      ]
    }
  },
  "model_groups": {
    "default": [
      "default",
      "last",
      "any"
    ],
    "code": [
      "code",
      "last",
      "any"
    ],
    "summarize": [
      "default",
      "last",
      "any"
    ],
    "explore": [
      "default",
      "last",
      "any"
    ],
    "explain": [
      "default",
      "last",
      "any"
    ],
    "prose": [
      "default",
      "last",
      "any"
    ]
  },
  "_comment_model_groups": "Each group lists member model keys in escalation order; first is the default.",
  "safety_threshold": 0.3,
  "default_route": "local",
  "charts": {
    "dir": "env/workflows/charts",
    "index_path": "data/workflow_library.sqlite",
    "selector_model": "code:default",
    "max_candidates": 5,
    "min_score": 0.6,
    "entity_context": true
  },
  "post_process": {
    "workflow_extraction": false
  },
  "ledger": {
    "path": "data/ledger.sqlite",
    "model": "code:default"
  },
  "session": {
    "root": "data/sessions"
  },
  "embedding_model": "embed",
  "gguf_dir": "/app/ai/models/gguf",
  "server": {
    "bind_addr": "127.0.0.1:8079",
    "max_payload": 1048576
  },
  "sidecar": {
    "poll_interval_s": 5,
    "vram_low_watermark_bytes": 1024000000,
    "evict_batch": 1,
    "vram_total_bytes": null,
    "minimum_remaining_vram": 2048000000,
    "slot_save_path": "data/slots",
    "resume_ttl_s": 3600,
    "server_state_path": "data/server_state.json",
    "api_key_env": null
  },
  "logging": {
    "log_dir": "logs",
    "max_file_size_mb": 10,
    "max_age_days": 3,
    "max_files": 4,
    "json_format": false,
    "console_output": true,
    "audit_log": {
      "log_dir": "logs/audit",
      "max_file_size_mb": 50,
      "max_age_days": 90,
      "max_files": 20,
      "json_format": true,
      "console_output": false
    }
  },
  "roles": {
    "default": {
      "models": [
        "code:default"
      ],
      "instance": "default"
    },
    "classifier": {
      "models": [
        "code:default"
      ],
      "instance": "default"
    },
    "code": {
      "models": [
        "code:default"
      ],
      "instance": "default"
    },
    "reasoning": {
      "models": [
        "code:default"
      ],
      "instance": "default"
    },
    "ledger": {
      "models": [
        "code:default"
      ],
      "instance": "default"
    }
  },
  "_comment_roles": "Roles are the routing vocabulary: groups reference roles (expanded per request to candidate keys), and a role's instance point is the single qualifier default. lfm2.5-2.6b keeps a per-model instances override (whole-profile replace): its context cap differs from the fleet default hoisted under default_params.instances."
}
