{"items": [
  {"id": "svo-01", "category": "svo", "text": "The cat sat on the mat."},
  {"id": "svo-02", "category": "svo", "text": "The dog barks loudly."},
  {"id": "svo-03", "category": "svo", "text": "She reads books daily."},
  {"id": "svo-04", "category": "svo", "text": "The chef cooked dinner."},
  {"id": "svo-05", "category": "svo", "text": "Birds sing softly."},
  {"id": "svo-06", "category": "svo", "text": "John opened the door."},
  {"id": "imperative-01", "category": "imperative", "text": "Show me the report."},
  {"id": "imperative-02", "category": "imperative", "text": "Open the door."},
  {"id": "imperative-03", "category": "imperative", "text": "Let the dead go bury their dead."},
  {"id": "imperative-04", "category": "imperative", "text": "Close the window now."},
  {"id": "imperative-05", "category": "imperative", "text": "Send the invoice today."},
  {"id": "imperative-06", "category": "imperative", "text": "Help them win."},
  {"id": "copular-01", "category": "copular", "text": "Your fee is low."},
  {"id": "copular-02", "category": "copular", "text": "The sky is blue."},
  {"id": "copular-03", "category": "copular", "text": "She is a doctor."},
  {"id": "copular-04", "category": "copular", "text": "The soup tastes salty."},
  {"id": "copular-05", "category": "copular", "text": "He became president."},
  {"id": "copular-06", "category": "copular", "text": "The results were surprising."},
  {"id": "subordinate-01", "category": "subordinate", "text": "As you know, your fee is low."},
  {"id": "subordinate-02", "category": "subordinate", "text": "I left because it rained."},
  {"id": "subordinate-03", "category": "subordinate", "text": "She sings when she works."},
  {"id": "subordinate-04", "category": "subordinate", "text": "If it rains, stay home."},
  {"id": "subordinate-05", "category": "subordinate", "text": "The meeting ended after he spoke."},
  {"id": "subordinate-06", "category": "subordinate", "text": "Although tired, she kept pace."},
  {"id": "parenthetical-01", "category": "parenthetical", "text": "My brother, a doctor, lives here."},
  {"id": "parenthetical-02", "category": "parenthetical", "text": "The report, frankly, was late."},
  {"id": "parenthetical-03", "category": "parenthetical", "text": "Paris, as always, charmed us."},
  {"id": "parenthetical-04", "category": "parenthetical", "text": "Her car, red and fast, won."},
  {"id": "parenthetical-05", "category": "parenthetical", "text": "The CEO, smiling, took questions."},
  {"id": "parenthetical-06", "category": "parenthetical", "text": "Truthfully, the plan failed."},
  {"id": "relative-01", "category": "relative", "text": "The man who called left."},
  {"id": "relative-02", "category": "relative", "text": "The book that I bought vanished."},
  {"id": "relative-03", "category": "relative", "text": "People who wait succeed."},
  {"id": "relative-04", "category": "relative", "text": "The house where I grew stands empty."},
  {"id": "relative-05", "category": "relative", "text": "The dog that barked ran off."},
  {"id": "relative-06", "category": "relative", "text": "Students who study pass."},
  {"id": "coordination-01", "category": "coordination", "text": "Cats and dogs play."},
  {"id": "coordination-02", "category": "coordination", "text": "She ran but fell."},
  {"id": "coordination-03", "category": "coordination", "text": "Buy milk and eggs."},
  {"id": "coordination-04", "category": "coordination", "text": "He laughed and cried."},
  {"id": "coordination-05", "category": "coordination", "text": "Run fast or lose."},
  {"id": "coordination-06", "category": "coordination", "text": "Tea or coffee helps mornings."},
  {"id": "contraction-01", "category": "contraction", "text": "Don't help them."},
  {"id": "contraction-02", "category": "contraction", "text": "I can't go today."},
  {"id": "contraction-03", "category": "contraction", "text": "She won't answer calls."},
  {"id": "contraction-04", "category": "contraction", "text": "We didn't see it."},
  {"id": "contraction-05", "category": "contraction", "text": "It's raining hard."},
  {"id": "contraction-06", "category": "contraction", "text": "You're late again."},
  {"id": "multiclause-01", "category": "multiclause", "text": "Let the dead go bury their dead; don't help them."},
  {"id": "multiclause-02", "category": "multiclause", "text": "She came; she saw; she left."},
  {"id": "multiclause-03", "category": "multiclause", "text": "The storm passed but floods stayed."},
  {"id": "multiclause-04", "category": "multiclause", "text": "Work hard, play fair."},
  {"id": "multiclause-05", "category": "multiclause", "text": "He cooks, she cleans."},
  {"id": "multiclause-06", "category": "multiclause", "text": "Prices rose yet wages stalled."},
  {"id": "question-01", "category": "question", "text": "What is 2+2?"},
  {"id": "question-02", "category": "question", "text": "Where is the station?"},
  {"id": "question-03", "category": "question", "text": "Who called earlier?"},
  {"id": "question-04", "category": "question", "text": "Can you help me?"},
  {"id": "question-05", "category": "question", "text": "Why is the sky blue?"},
  {"id": "question-06", "category": "question", "text": "Did the report arrive?"},
  {"id": "command-01", "category": "command", "text": "Summarize this article."},
  {"id": "command-02", "category": "command", "text": "Translate hello to French."},
  {"id": "command-03", "category": "command", "text": "Find the cheapest flight."},
  {"id": "command-04", "category": "command", "text": "Remind me at noon."},
  {"id": "command-05", "category": "command", "text": "Search the web for pensions."},
  {"id": "command-06", "category": "command", "text": "Explain Bell's theorem."}
]}
